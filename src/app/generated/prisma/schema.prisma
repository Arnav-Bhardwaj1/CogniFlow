// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../src/app/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  workflows     Workflow[]
  credentials   Credential[] // a user can have multiple credentials, for example, one for OpenAI, one for Anthropic, etc.

  @@unique([email])
  @@map("user") // means the table name in the database is "user"
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId]) // means we create an index on userId for faster lookups
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Workflow {
  id   String @id @default(cuid())
  name String

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      String
  connections Connection[]
  nodes       Node[] // does not store anything in the database, just a relation field to get all nodes related to this workflow. syntax to get the nodes of a workflow: workflow.nodes. To access workflow.nodes, you must explicitly include it in the Prisma query using include: { nodes: true }
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions  Execution[]
}

model Credential {
  id        String         @id @default(cuid())
  name      String
  value     String
  type      CredentialType
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  Node Node[]
}

enum CredentialType {
  OPENAI
  ANTHROPIC
  GEMINI
}

model Node {
  id                String       @id @default(cuid())
  name              String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  type              NodeType
  position          Json
  data              Json         @default("{}") // why default "{}": to avoid null values
  workflowId        String
  credentialId      String?
  credential        Credential?  @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  outputConnections Connection[] @relation("FromNode") // These are the Connection records where this node is the source (fromNodeId). This field pairs with Connection.fromNode via the relation name FromNode so Prisma knows which foreign key to use.
  inputConnections  Connection[] @relation("ToNode") // These are the Connection records where this node is the target (toNodeId). This field pairs with Connection.toNode via the relation name ToNode so Prisma knows which foreign key to use.
  workflow          Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model Connection {
  id         String   @id @default(cuid())
  workflowId String
  fromNodeId String
  toNodeId   String
  fromOutput String   @default("main") // explain this? this indicates the output port of the source node from which the connection originates. Default name is "main". Port means the "black dot" on the ends of the connection line.
  toInput    String   @default("main")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  fromNode   Node     @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade) //explain this? this sets up a relation to the Node model using the fromNodeId field as the foreign key, referencing the id field in the Node model. The relation is named "FromNode" to distinguish it from other relations to the Node model.
  toNode     Node     @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, fromOutput, toInput]) // explain this? to prevent duplicate connections
}

// fromNode means the source node of the connection, toNode means the target node of the connection, toNodeId means the id of the target node of the connection

model Execution {
  id             String          @id @default(cuid())
  workflowId     String
  workflow       Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status         ExecutionStatus @default(RUNNING)
  error          String?         @db.Text // to store error message if the execution fails
  errorStack     String?         @db.Text // to store error stack trace if the execution fails
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  inngestEventId String          @unique
  output         Json?
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum NodeType {
  INITIAL // the starting node of a workflow
  MANUAL_TRIGGER // a node that triggers the workflow manually
  HTTP_REQUEST // a node that makes an HTTP request
  GOOGLE_FORM_TRIGGER // a node that triggers the workflow when a Google Form is submitted
  RAZORPAY_TRIGGER // a node that triggers the workflow when a RazorPay payment/event occurs
  ANTHROPIC
  GEMINI
  OPENAI
  DISCORD
  SLACK
}
